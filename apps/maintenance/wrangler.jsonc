{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mutuallens-maintenance",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [{ "binding": "JOBS", "database_name": "mutuallens-jobs" }],
  "vars": {
    "AUTOMATIC_ENABLED": "false",
    "AUTOMATIC_VALIDATION_ID": "",
    "AUTOMATIC_WINDOW_USD": "4.5",
    "AUTOMATIC_JOB_USD": "3",
    "AUTOMATIC_RUN_USD": "0.1",
    "AUTOMATIC_RESERVE_USD": "0.5",
  },
  "secrets": { "required": ["APIFY_TOKEN"] },
}
