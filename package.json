{
  "name": "mutuallens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "check": "npm run lint && npm run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && npm run check -w @mutuallens/site",
    "test": "vitest run",
    "test:browser": "playwright test",
    "build": "npm run build -w @mutuallens/checker && npm run build -w @mutuallens/site && node scripts/build-security.mjs",
    "dev:checker": "npm run dev -w @mutuallens/checker",
    "dev:site": "npm run dev -w @mutuallens/site",
    "dev": "node scripts/serve.mjs dev",
    "preview": "node scripts/serve.mjs preview",
    "test:browser:dev": "MUTUALLENS_TEST_MODE=dev playwright test repair-workflows repair-transitions",
    "test:startup": "node scripts/test-startup.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "5.20260911.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "wrangler": "4.131.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260911.1": true
  }
}
